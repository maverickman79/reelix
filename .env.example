# Reelix environment.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Database password. There is no default; both the app and Postgres refuse to
# start without it.
REELIX_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Address the server publishes on. NO DEFAULT, deliberately: a default of
# 0.0.0.0 baked into the compose file would silently put the listener on the
# public internet the first time somebody forgot to set this.
#
# The development VPS uses its Tailscale address, so the listener is reachable
# over the tailnet and nowhere else. A LAN host — Unraid, typically — uses
# 0.0.0.0 and relies on the LAN boundary.
REELIX_HTTP_BIND=100.95.0.122

# Host port for the server. The container always listens on 8080 internally.
REELIX_HTTP_PORT=8080

# Host directory holding your media. Mounted read-only at /media.
#
# For development against the Step 0 test library, point this at it:
#   REELIX_MEDIA_DIR=./hack/capture/test-media
# That directory is gitignored, so this stays a local choice rather than
# something baked into the canonical compose file.
REELIX_MEDIA_DIR=./media

# Image tag, and the version reported by /health.
REELIX_VERSION=0.0.1

# Published image. The canonical stack PULLS this; it does not build it.
# To build from this checkout instead:
#   docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
REELIX_IMAGE=ghcr.io/maverickman79/reelix/server

# User the container runs as. The image's own default is 1000, which suits a
# desktop-Linux host. On Unraid set 99:100 (nobody:users), which is what owns
# the shares and the appdata directory.
REELIX_UID=1000
REELIX_GID=1000

# Unraid only, with docker-compose.unraid.yml: where the bind-mounted state
# lives. This must be on the CACHE POOL, not the array — see that file.
# REELIX_APPDATA=/mnt/user/appdata/reelix

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug | info | warn | error
REELIX_LOG_LEVEL=info

# json | text  — json for deployment, text when reading logs by eye.
REELIX_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

REELIX_DB_NAME=reelix
REELIX_DB_USER=reelix

# disable is correct while Postgres is reachable only on the internal compose
# network. Use require or verify-full for an external database.
REELIX_DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Metadata provider
# ---------------------------------------------------------------------------

# TMDB is the movie identity provider. REQUIRED: the server refuses to start
# without it, naming this variable, rather than failing on the first item of
# an identify pass. Get a key at https://www.themoviedb.org/settings/api
REELIX_TMDB_API_KEY=

# Which country's film certification becomes OfficialRating: an ISO 3166-1
# two-letter code. Defaults to US.
#
# A film with no certification for this region gets an EMPTY rating. It does
# not fall back to another region -- showing a US rating to someone who
# configured GB is a wrong answer that looks like a right one.
REELIX_METADATA_REGION=US

# ---------------------------------------------------------------------------
# Advanced
# ---------------------------------------------------------------------------
# These have working defaults and are read directly by the server; set them
# only when running outside the compose stack.
#
# REELIX_HTTP_ADDR=:8080
# REELIX_CONFIG_DIR=/config
# REELIX_CACHE_DIR=/cache
# REELIX_SHUTDOWN_TIMEOUT=15s
# REELIX_DB_HOST=postgres
# REELIX_DB_PORT=5432
# REELIX_TMDB_BASE_URL=https://api.themoviedb.org/3
# REELIX_METADATA_TIMEOUT=15s
#
# Artwork. Image bytes come from a different host from the API, carry no API
# key, and are measured in megabytes rather than kilobytes -- hence a separate
# base URL and a longer timeout. Downloaded images are stored under
# REELIX_CACHE_DIR, which must be a persistent volume; losing it is recoverable
# (the next metadata refresh re-downloads) but costs one request per image.
# REELIX_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# REELIX_IMAGE_TIMEOUT=60s
